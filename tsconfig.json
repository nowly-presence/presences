{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "#/*": ["../sdk/src/*"]
    }
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"]
}
